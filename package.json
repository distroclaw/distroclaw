{
  "name": "distroclaw",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:app": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare-engine": "node scripts/prepare-engine.mjs",
    "dist": "npm run prepare-engine -- --no-model && tauri build --bundles app --config src-tauri/tauri.bundle.conf.json && bash scripts/make-dmg.sh",
    "brand": "node scripts/build-brand.mjs",
    "dist:offline": "npm run prepare-engine && tauri build --bundles app --config src-tauri/tauri.offline.conf.json && bash scripts/make-dmg.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vite build && cd src-tauri && cargo test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "opentype.js": "^1.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
